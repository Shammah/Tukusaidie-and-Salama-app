# Copy to .env for local development. On Render, set these in the dashboard instead.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# The owner's admin sign-in (created or reset on every start)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Public https address of the site; Safaricom sends payment results here
PUBLIC_URL=https://your-app.onrender.com

# M-Pesa: simulate (local testing), sandbox (Safaricom test system) or production (real money)
MPESA_ENV=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox defaults to shortcode 174379 and Safaricom's public test passkey when these are empty
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Number customers pay into by hand (till or paybill). Defaults to MPESA_SHORTCODE
MPESA_TILL=

# Leave empty to use SQLite in instance/. Render sets this to its Postgres database.
DATABASE_URL=

# Password for the sample accounts created by `flask --app wsgi seed-demo`
DEMO_PASSWORD=demo-pass-2026
